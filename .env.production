# ==============================================================================
# OMS Next.js Frontend — Production Environment Configuration (.env.production)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application Branding
NEXT_PUBLIC_APP_NAME="OMS Enterprise"

# FastAPI Backend Production Base URL
# If hosting behind a unified reverse proxy (Nginx / Caddy), use: /api/v1
# If hosting on a separate API subdomain, use: https://api.yourdomain.com/api/v1
# Default production internal: http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Terminal Identification
NEXT_PUBLIC_DEFAULT_DEVICE_UUID=web-terminal-001
